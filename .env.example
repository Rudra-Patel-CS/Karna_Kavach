# ─── KarnaKavach Environment Configuration ───────────────────────────────────
# Copy this file to .env.local (for local development) or configure these in Render.
# NEVER commit sensitive keys to source control.

# ─── Server Configuration ───────────────────────────────────────────────────
# The port the Node Express server will listen on. (Render sets this automatically)
PORT=3000

# The environment mode (production/development)
NODE_ENV=production

# ─── Gemini AI Engine ────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ─── Firebase Configuration ──────────────────────────────────────────────────
# Copy these values from Firebase Console → Project Settings → Your apps
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
VITE_FIREBASE_DATABASE_ID=your-firestore-database-id
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Python Environment (Implicit / Subprocess Settings) ──────────────────────
# Force spawned Python subprocesses to use UTF-8 encoding (handled internally by server.ts, but can be set globally)
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
